             + (96950 - 23850) * 0.12
             + (206700 - 96950) * 0.22
             + (394600 - 206700) * 0.24
             + 0.32 * (?TI - 394600).

tax_liability(2025, married_filing_jointly, ?TI, ?Tax) :-
    ?TI > 501050, ?TI =< 751600,
    ?Tax \is 23850 * 0.10
             + (96950 - 23850) * 0.12
             + (206700 - 96950) * 0.22
             + (394600 - 206700) * 0.24
             + (501050 - 394600) * 0.32
             + 0.35 * (?TI - 501050).

tax_liability(2025, married_filing_jointly, ?TI, ?Tax) :-
    ?TI > 751600,
    ?Tax \is 23850 * 0.10
             + (96950 - 23850) * 0.12
             + (206700 - 96950) * 0.22
             + (394600 - 206700) * 0.24
             + (501050 - 394600) * 0.32
             + (751600 - 501050) * 0.35
             + 0.37 * (?TI - 751600).

// Qualifying surviving spouse shares the MFJ brackets.

tax_liability(2025, qualifying_surviving_spouse, ?TI, ?Tax) :-
    tax_liability(2025, married_filing_jointly, ?TI, ?Tax).

