// ---- /Users/z/Desktop/Coherent/Honor Thesis/rules/1040/taxable_income.ergo ----
// Taxable income computation.

deduction_used(?T, ?Year, ?Ded) :-
    tax_year(?Year),
    standard_deduction(?T, ?Year, ?SD),
    itemized_deduction(?T, ?Year, ?ID),
    max2(?SD, ?ID, ?Ded).

taxable_income(?T, ?Year, ?TI) :-
    agi(?T, ?AGI),
    deduction_used(?T, ?Year, ?Ded),
    ?AGI =< ?Ded,
    ?TI \is 0.

taxable_income(?T, ?Year, ?TI) :-
    agi(?T, ?AGI),
    deduction_used(?T, ?Year, ?Ded),
    ?AGI > ?Ded,
    ?TI \is ?AGI - ?Ded.


// ---- /Users/z/Desktop/Coherent/Honor Thesis/rules/1040/summary_and_explanations.ergo ----
// Summary view and line-by-line explanations.

// tax_summary(T, Year, Status, AGI, StdDed, TaxableIncome, Tax).

tax_summary(?T, ?Year, ?Status, ?AGI, ?SD, ?TI, ?Tax) :-
    tax_year(?Year),
    filing_status(?T, ?Status),
    agi(?T, ?AGI),
    standard_deduction(?T, ?Year, ?SD),
    taxable_income(?T, ?Year, ?TI),
    tax_liability(?Year, ?Status, ?TI, ?Tax).

// Deterministic wrapper to avoid backtracking over multiple bracket solutions.
tax_summary_det(?T, ?Year, ?Status, ?AGI, ?SD, ?TI, ?Tax) :-
    tax_summary(?T, ?Year, ?Status, ?AGI, ?SD, ?TI, ?Tax),
    !.

// Line-value facade for explainability.

line_value(?_T, 'tax_year', ?Year) :-
    tax_year(?Year).

line_explanation(?_T, 'tax_year',
                 'Tax year is currently configured globally in rules/1040/config.ergo.') :-
    tax_year(_).

line_value(?T, 'filing_status', ?Status) :-
    filing_status(?T, ?Status).

line_explanation(?T, 'filing_status',
                 'Filing status is taken from the taxpayer\'s declared filing_status fact.') :-
    filing_status(?T, _).

line_value(?T, 'agi', ?AGI) :-
    agi(?T, ?AGI).

line_explanation(?T, 'agi',
                 'Adjusted Gross Income (AGI) equals total income minus adjustments (floored at 0).') :-
    agi(?T, _).

line_value(?T, 'total_income', ?Total) :-
    income_sum(?T, ?Total).

line_explanation(?T, 'total_income',
                 'Total income aggregates all provided income sources (wages, interest, dividends, gains, business, rentals, royalties, farm, refunds, alimony, social security, unemployment, other).') :-
    income_sum(?T, _).

line_value(?T, 'adjustments_total', ?Adj) :-
    adjustment_sum(?T, ?Adj).

line_explanation(?T, 'adjustments_total',
                 'Adjustments total aggregates deductible adjustments from Schedule 1 inputs (if provided).') :-
    adjustment_sum(?T, _).

line_value(?T, 'itemized_deduction', ?ID) :-
    tax_year(?Year),
    itemized_deduction(?T, ?Year, ?ID).

line_explanation(?T, 'itemized_deduction',
                 'Itemized deduction aggregates deductible Schedule A components (medical above floor, SALT capped, mortgage interest, charitable, casualty, other) when provided.') :-
    tax_year(?Year),
    itemized_deduction(?T, ?Year, _).

line_value(?T, 'deduction_used', ?Ded) :-
    tax_year(?Year),
    deduction_used(?T, ?Year, ?Ded).

line_explanation(?T, 'deduction_used',
                 'Deduction used is the larger of standard deduction and itemized deduction.') :-
    tax_year(?Year),
    deduction_used(?T, ?Year, _).

line_value(?T, 'standard_deduction', ?SD) :-
    tax_year(?Year),
    standard_deduction(?T, ?Year, ?SD).

line_explanation(?T, 'standard_deduction',
                 'The standard deduction equals the basic amount for the filing status plus any additional amount for age 65+ and/or blindness (traditional additional standard deduction only).') :-
    tax_year(?Year),
    standard_deduction(?T, ?Year, _).

line_value(?T, 'taxable_income', ?TI) :-
    tax_year(?Year),
    taxable_income(?T, ?Year, ?TI).

line_explanation(?T, 'taxable_income',
                 'Taxable income is AGI minus the deduction used (max of standard vs itemized), floored at 0 if deductions exceed AGI.') :-
    tax_year(?Year),
    taxable_income(?T, ?Year, _).

line_value(?T, 'tax_liability', ?Tax) :-
    tax_year(?Year),
    filing_status(?T, ?Status),
    taxable_income(?T, ?Year, ?TI),
    tax_liability(?Year, ?Status, ?TI, ?Tax).

line_explanation(?T, 'tax_liability',
                 'Tax liability is computed using the progressive tax brackets for the taxpayer\'s filing status.') :-
    tax_year(?Year),
    filing_status(?T, ?Status),
    taxable_income(?T, ?Year, ?TI),
    tax_liability(?Year, ?Status, ?TI, _).


// ---- /Users/z/Desktop/Coherent/Honor Thesis/tests/examples_2025_basic.ergo ----
// Basic 2025 examples for filing status, standard deduction, taxable income, and tax liability.

// -------------------------
// Example 1: Alice (single)
// -------------------------
//  - Single
//  - Wages: 60,000
//  - Under 65, not blind.

filing_status(alice, single).
wage_income(alice, 60000).

age_65_or_over_flag(alice, 0).
blind_flag(alice, 0).
spouse_age_65_or_over_flag(alice, 0).
spouse_blind_flag(alice, 0).

// Expected values for Alice (2025 rules):
//   AGI = 60,000
//   Std. deduction (single, under 65, not blind) = 15,750
//   Taxable income = 44,250
//   Tax = 5,071.5

expected_taxable_income(alice, 44250).
expected_tax(alice, 5071.5).

// -------------------------
// Example 2: Joan (single)
// -------------------------
//  - Single
//  - Wages: 110,000
//  - Under 65, not blind.

filing_status(joan, single).
wage_income(joan, 110000).

age_65_or_over_flag(joan, 0).
blind_flag(joan, 0).
spouse_age_65_or_over_flag(joan, 0).
spouse_blind_flag(joan, 0).

// Expected values for Joan (2025 rules):
//   AGI = 110,000
//   Std. deduction (single, under 65, not blind) = 15,750
//   Taxable income = 94,250
//   Tax = 15,649

expected_taxable_income(joan, 94250).
expected_tax(joan, 15649).

// -------------------------
// Example 3: Bob (single)
// -------------------------
//  - Single
//  - Wages: 50,000
//  - Taxable interest: 200
//  - Ordinary dividends: 300
//  - Under 65, not blind.

filing_status(bob, single).
wage_income(bob, 50000).
taxable_interest_income(bob, 200).
ordinary_dividends(bob, 300).

age_65_or_over_flag(bob, 0).
blind_flag(bob, 0).
spouse_age_65_or_over_flag(bob, 0).
spouse_blind_flag(bob, 0).

// Expected values for Bob (2025 rules):
//   AGI = 50,500
//   Std. deduction (single, under 65, not blind) = 15,750
//   Taxable income = 34,750
//   Tax = 3,931.5

expected_taxable_income(bob, 34750).
expected_tax(bob, 3931.5).

// Simple correctness check: does our model match expected numbers?

case_ok(?T) :-
    tax_year(?Year),
    expected_taxable_income(?T, ?ExpTI),
    expected_tax(?T, ?ExpTax),
    tax_summary(?T, ?Year, _Status, _AGI, _SD, ?TI, ?Tax),
    ?TI =:= ?ExpTI,
    ?Tax =:= ?ExpTax.

case_ok(?T) :-
    agi_case_ok(?T).


// ---- /Users/z/Desktop/Coherent/Honor Thesis/tests/examples_2025_agi.ergo ----
// AGI-focused examples for 2025 (income + adjustments coverage).

// Example: Dana (single)
//  - Wages: 80,000
//  - Interest: 500
//  - Dividends: 300
//  - Capital gains: 1,200
//  - Unemployment: 0
//  - Adjustments: IRA 2,000; HSA 1,000
// Expected AGI = 80,000 + 500 + 300 + 1,200 - 2,000 - 1,000 = 79,000

filing_status(dana, single).
wage_income(dana, 80000).
taxable_interest_income(dana, 500).
ordinary_dividends(dana, 300).
capital_gains(dana, 1200).

ira_deduction(dana, 2000).
hsa_deduction(dana, 1000).

age_65_or_over_flag(dana, 0).
blind_flag(dana, 0).
spouse_age_65_or_over_flag(dana, 0).
spouse_blind_flag(dana, 0).

expected_agi(dana, 79000).

agi_case_ok(?T) :-
    expected_agi(?T, ?ExpAGI),
    agi(?T, ?AGI),
    ?AGI =:= ?ExpAGI.


