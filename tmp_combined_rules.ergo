// ---- /Users/z/Desktop/Coherent/Honor Thesis/rules/1040/config.ergo ----
// Global configuration for the 1040 ruleset.
// Update tax_year/1 when adding a new year-specific data folder.

tax_year(2025).


// ---- /Users/z/Desktop/Coherent/Honor Thesis/rules/1040/agi.ergo ----
// Adjusted Gross Income (AGI)
// Phase 1: income aggregation + adjustments (prototype).

// Income sources (amounts are taxable amounts).
// wage_income(T, Amount).
// taxable_interest_income(T, Amount).
// ordinary_dividends(T, Amount).
// qualified_dividends(T, Amount).  % treated as income here; tax rate handled later
// capital_gains(T, Amount).
// business_income(T, Amount).
// rental_income(T, Amount).
// royalty_income(T, Amount).
// farm_income(T, Amount).
// taxable_refunds(T, Amount).
// alimony_received_pre2019(T, Amount).
// social_security_taxable(T, Amount).
// unemployment_comp(T, Amount).
// other_income(T, Amount).

// NOTE: income_total/2 is kept for backwards compatibility.
// Prefer income_item/2 + income_sum/2.

income_item(?T, ?Total) :-
    wage_income(?T, ?W),
    ?Total \is ?W.

income_item(?T, ?Total) :-
    taxable_interest_income(?T, ?I),
    ?Total \is ?I.

income_item(?T, ?Total) :-
    ordinary_dividends(?T, ?D),
    ?Total \is ?D.

income_item(?T, ?Total) :-
    qualified_dividends(?T, ?QD),
    ?Total \is ?QD.

income_item(?T, ?Total) :-
    capital_gains(?T, ?G),
    ?Total \is ?G.

income_item(?T, ?Total) :-
    business_income(?T, ?B),
    ?Total \is ?B.

income_item(?T, ?Total) :-
    rental_income(?T, ?R),
    ?Total \is ?R.

income_item(?T, ?Total) :-
    royalty_income(?T, ?R),
    ?Total \is ?R.

income_item(?T, ?Total) :-
    farm_income(?T, ?F),
    ?Total \is ?F.

income_item(?T, ?Total) :-
    taxable_refunds(?T, ?TR),
    ?Total \is ?TR.

income_item(?T, ?Total) :-
    alimony_received_pre2019(?T, ?A),
    ?Total \is ?A.

income_item(?T, ?Total) :-
    social_security_taxable(?T, ?SS),
    ?Total \is ?SS.

income_item(?T, ?Total) :-
    unemployment_comp(?T, ?U),
    ?Total \is ?U.

income_item(?T, ?Total) :-
    other_income(?T, ?O),
    ?Total \is ?O.

income_total(?T, ?Total) :-
    income_item(?T, ?Total).

// Aggregate helpers with empty-set defaults.
// Avoid aggregates to keep compatibility with minimal Ergo setups.
income_sum(?T, ?Total) :-
    wage_income_or_zero(?T, ?W),
    taxable_interest_or_zero(?T, ?I),
    ordinary_dividends_or_zero(?T, ?D),
    qualified_dividends_or_zero(?T, ?QD),
    capital_gains_or_zero(?T, ?G),
    business_income_or_zero(?T, ?B),
    rental_income_or_zero(?T, ?R),
    royalty_income_or_zero(?T, ?Ry),
    farm_income_or_zero(?T, ?F),
    taxable_refunds_or_zero(?T, ?TR),
    alimony_received_pre2019_or_zero(?T, ?A),
    social_security_taxable_or_zero(?T, ?SS),
    unemployment_comp_or_zero(?T, ?U),
    other_income_or_zero(?T, ?O),
    ?Total \is ?W + ?I + ?D + ?QD + ?G + ?B + ?R + ?Ry + ?F + ?TR + ?A + ?SS + ?U + ?O.

wage_income_or_zero(?T, ?W) :-
    wage_income(?T, ?W),
    !.
wage_income_or_zero(?T, 0) :-
    \+ wage_income(?T, _).

taxable_interest_or_zero(?T, ?I) :-
    taxable_interest_income(?T, ?I),
    !.
taxable_interest_or_zero(?T, 0) :-
    \+ taxable_interest_income(?T, _).

ordinary_dividends_or_zero(?T, ?D) :-
    ordinary_dividends(?T, ?D),
    !.
ordinary_dividends_or_zero(?T, 0) :-
    \+ ordinary_dividends(?T, _).

qualified_dividends_or_zero(?T, ?QD) :-
    qualified_dividends(?T, ?QD),
    !.
qualified_dividends_or_zero(?T, 0) :-
    \+ qualified_dividends(?T, _).

capital_gains_or_zero(?T, ?G) :-
    capital_gains(?T, ?G),
    !.
capital_gains_or_zero(?T, 0) :-
    \+ capital_gains(?T, _).

business_income_or_zero(?T, ?B) :-
    business_income(?T, ?B),
    !.
business_income_or_zero(?T, 0) :-
    \+ business_income(?T, _).

rental_income_or_zero(?T, ?R) :-
    rental_income(?T, ?R),
    !.
rental_income_or_zero(?T, 0) :-
    \+ rental_income(?T, _).

royalty_income_or_zero(?T, ?Ry) :-
    royalty_income(?T, ?Ry),
    !.
royalty_income_or_zero(?T, 0) :-
    \+ royalty_income(?T, _).

farm_income_or_zero(?T, ?F) :-
    farm_income(?T, ?F),
    !.
farm_income_or_zero(?T, 0) :-
    \+ farm_income(?T, _).

taxable_refunds_or_zero(?T, ?TR) :-
    taxable_refunds(?T, ?TR),
    !.
taxable_refunds_or_zero(?T, 0) :-
    \+ taxable_refunds(?T, _).

alimony_received_pre2019_or_zero(?T, ?A) :-
    alimony_received_pre2019(?T, ?A),
    !.
alimony_received_pre2019_or_zero(?T, 0) :-
    \+ alimony_received_pre2019(?T, _).

social_security_taxable_or_zero(?T, ?SS) :-
    social_security_taxable(?T, ?SS),
    !.
social_security_taxable_or_zero(?T, 0) :-
    \+ social_security_taxable(?T, _).

unemployment_comp_or_zero(?T, ?U) :-
    unemployment_comp(?T, ?U),
    !.
unemployment_comp_or_zero(?T, 0) :-
    \+ unemployment_comp(?T, _).

other_income_or_zero(?T, ?O) :-
    other_income(?T, ?O),
    !.
other_income_or_zero(?T, 0) :-
    \+ other_income(?T, _).

// Adjustments to income (Schedule 1 style; amounts are deductible adjustments).
// educator_expenses(T, Amount).
// ira_deduction(T, Amount).
// student_loan_interest(T, Amount).
// hsa_deduction(T, Amount).
// self_employment_tax_deduction(T, Amount).
// self_employed_health_insurance(T, Amount).
// penalty_on_early_withdrawal(T, Amount).
// sep_simple_qualified_plans(T, Amount).
// self_employed_retirement(T, Amount).
// moving_expenses_active_duty(T, Amount).
// alimony_paid_pre2019(T, Amount).
// other_adjustments(T, Amount).

// NOTE: adjustment_total/2 is kept for backwards compatibility.
// Prefer adjustment_item/2 + adjustment_sum/2.

adjustment_item(?T, ?Total) :-
    educator_expenses(?T, ?E),
    ?Total \is ?E.

adjustment_item(?T, ?Total) :-
    ira_deduction(?T, ?I),
    ?Total \is ?I.

adjustment_item(?T, ?Total) :-
    student_loan_interest(?T, ?S),
    ?Total \is ?S.

adjustment_item(?T, ?Total) :-
    hsa_deduction(?T, ?H),
    ?Total \is ?H.

adjustment_item(?T, ?Total) :-
    self_employment_tax_deduction(?T, ?SE),
    ?Total \is ?SE.

adjustment_item(?T, ?Total) :-
    self_employed_health_insurance(?T, ?HI),
    ?Total \is ?HI.

adjustment_item(?T, ?Total) :-
    penalty_on_early_withdrawal(?T, ?P),
    ?Total \is ?P.

adjustment_item(?T, ?Total) :-
    sep_simple_qualified_plans(?T, ?SEP),
    ?Total \is ?SEP.

adjustment_item(?T, ?Total) :-
    self_employed_retirement(?T, ?SER),
    ?Total \is ?SER.

adjustment_item(?T, ?Total) :-
    moving_expenses_active_duty(?T, ?M),
    ?Total \is ?M.

adjustment_item(?T, ?Total) :-
    alimony_paid_pre2019(?T, ?A),
    ?Total \is ?A.

adjustment_item(?T, ?Total) :-
    other_adjustments(?T, ?O),
    ?Total \is ?O.

adjustment_total(?T, ?Total) :-
    adjustment_item(?T, ?Total).

adjustment_sum(?T, ?Total) :-
    educator_expenses_or_zero(?T, ?E),
    ira_deduction_or_zero(?T, ?I),
    student_loan_interest_or_zero(?T, ?S),
    hsa_deduction_or_zero(?T, ?H),
    self_employment_tax_deduction_or_zero(?T, ?SE),
    self_employed_health_insurance_or_zero(?T, ?HI),
    penalty_on_early_withdrawal_or_zero(?T, ?P),
    sep_simple_qualified_plans_or_zero(?T, ?SEP),
    self_employed_retirement_or_zero(?T, ?SER),
    moving_expenses_active_duty_or_zero(?T, ?M),
    alimony_paid_pre2019_or_zero(?T, ?A),
    other_adjustments_or_zero(?T, ?O),
    ?Total \is ?E + ?I + ?S + ?H + ?SE + ?HI + ?P + ?SEP + ?SER + ?M + ?A + ?O.

educator_expenses_or_zero(?T, ?E) :-
    educator_expenses(?T, ?E),
    !.
educator_expenses_or_zero(?T, 0) :-
    \+ educator_expenses(?T, _).

ira_deduction_or_zero(?T, ?I) :-
    ira_deduction(?T, ?I),
    !.
ira_deduction_or_zero(?T, 0) :-
    \+ ira_deduction(?T, _).

student_loan_interest_or_zero(?T, ?S) :-
    student_loan_interest(?T, ?S),
    !.
student_loan_interest_or_zero(?T, 0) :-
    \+ student_loan_interest(?T, _).

hsa_deduction_or_zero(?T, ?H) :-
    hsa_deduction(?T, ?H),
    !.
hsa_deduction_or_zero(?T, 0) :-
    \+ hsa_deduction(?T, _).

self_employment_tax_deduction_or_zero(?T, ?SE) :-
    self_employment_tax_deduction(?T, ?SE),
    !.
self_employment_tax_deduction_or_zero(?T, 0) :-
    \+ self_employment_tax_deduction(?T, _).

self_employed_health_insurance_or_zero(?T, ?HI) :-
    self_employed_health_insurance(?T, ?HI),
    !.
self_employed_health_insurance_or_zero(?T, 0) :-
    \+ self_employed_health_insurance(?T, _).

penalty_on_early_withdrawal_or_zero(?T, ?P) :-
    penalty_on_early_withdrawal(?T, ?P),
    !.
penalty_on_early_withdrawal_or_zero(?T, 0) :-
    \+ penalty_on_early_withdrawal(?T, _).

sep_simple_qualified_plans_or_zero(?T, ?SEP) :-
    sep_simple_qualified_plans(?T, ?SEP),
    !.
sep_simple_qualified_plans_or_zero(?T, 0) :-
    \+ sep_simple_qualified_plans(?T, _).

self_employed_retirement_or_zero(?T, ?SER) :-
    self_employed_retirement(?T, ?SER),
    !.
self_employed_retirement_or_zero(?T, 0) :-
    \+ self_employed_retirement(?T, _).

moving_expenses_active_duty_or_zero(?T, ?M) :-
    moving_expenses_active_duty(?T, ?M),
    !.
moving_expenses_active_duty_or_zero(?T, 0) :-
    \+ moving_expenses_active_duty(?T, _).

alimony_paid_pre2019_or_zero(?T, ?A) :-
    alimony_paid_pre2019(?T, ?A),
    !.
alimony_paid_pre2019_or_zero(?T, 0) :-
    \+ alimony_paid_pre2019(?T, _).

other_adjustments_or_zero(?T, ?O) :-
    other_adjustments(?T, ?O),
    !.
other_adjustments_or_zero(?T, 0) :-
    \+ other_adjustments(?T, _).

// AGI = total income - adjustments (floored at 0).
max2_agi(?A, ?B, ?Max) :-
    ?A >= ?B,
    ?Max \is ?A.

max2_agi(?A, ?B, ?Max) :-
    ?A < ?B,
    ?Max \is ?B.

agi(?T, ?AGI) :-
    income_sum(?T, ?Income),
    adjustment_sum(?T, ?Adj),
    ?Temp \is ?Income - ?Adj,
    max2_agi(?Temp, 0, ?AGI).


// ---- /Users/z/Desktop/Coherent/Honor Thesis/rules/1040/2025/standard_deduction.ergo ----
// Standard deduction rules for tax year 2025.

// 2025 standard deduction under OBBB + inflation:
//   - $15,750  Single or MFS
//   - $31,500  MFJ / QSS
//   - $23,625  Head of Household

base_standard_deduction(2025, single,                      15750).
base_standard_deduction(2025, married_filing_separately,   15750).
base_standard_deduction(2025, married_filing_jointly,      31500).
base_standard_deduction(2025, qualifying_surviving_spouse, 31500).
base_standard_deduction(2025, head_of_household,           23625).

// Additional standard deduction for age 65+ / blind (2025)
//   - Single or Head of Household: $2,000 per qualifier
//   - Married / QSS:               $1,600 per qualifier
// Note: excludes any separate senior add-on deduction.

per_qualifier_additional_amount(2025, single,                      2000).
per_qualifier_additional_amount(2025, head_of_household,           2000).
per_qualifier_additional_amount(2025, married_filing_jointly,      1600).
per_qualifier_additional_amount(2025, married_filing_separately,   1600).
per_qualifier_additional_amount(2025, qualifying_surviving_spouse, 1600).

// Helper: count age/blind qualifiers on the return (0–4).

qualifier_count(?T, ?Count) :-
    age_65_or_over_flag(?T,           ?SelfAge),
    blind_flag(?T,                    ?SelfBlind),
    spouse_age_65_or_over_flag(?T,    ?SpouseAge),
    spouse_blind_flag(?T,             ?SpouseBlind),
    ?Count \is ?SelfAge + ?SelfBlind + ?SpouseAge + ?SpouseBlind.

additional_standard_deduction(?T, 2025, ?Extra) :-
    filing_status(?T, ?Status),
    per_qualifier_additional_amount(2025, ?Status, ?PerQual),
    qualifier_count(?T, ?Count),
    ?Extra \is ?PerQual * ?Count.

standard_deduction(?T, 2025, ?Amount) :-
    filing_status(?T, ?Status),
    base_standard_deduction(2025, ?Status, ?Base),
    additional_standard_deduction(?T, 2025, ?Extra),
    ?Amount \is ?Base + ?Extra.


// ---- /Users/z/Desktop/Coherent/Honor Thesis/rules/1040/2025/itemized_deductions.ergo ----
// Itemized deductions (Schedule A) for tax year 2025.

// Inputs (amounts are deductible amounts unless stated otherwise):
// medical_expenses(T, Amount).
// state_local_income_taxes(T, Amount).
// state_local_sales_taxes(T, Amount).
// real_estate_taxes(T, Amount).
// personal_property_taxes(T, Amount).
// mortgage_interest(T, Amount).
// charitable_cash(T, Amount).
// charitable_noncash(T, Amount).
// casualty_losses(T, Amount).
// other_itemized(T, Amount).

// Policy parameters (year-specific):
// medical_floor_pct(Year, Pct).
// salt_cap(Year, Cap).

medical_floor_pct(2025, 0.075).
salt_cap(2025, 10000).

// Helpers.

min2(?A, ?B, ?Min) :-
    ?A =< ?B,
    ?Min \is ?A.

min2(?A, ?B, ?Min) :-
    ?A > ?B,
    ?Min \is ?B.

max2(?A, ?B, ?Max) :-
    ?A >= ?B,
    ?Max \is ?A.

max2(?A, ?B, ?Max) :-
    ?A < ?B,
    ?Max \is ?B.

// Medical deduction subject to AGI floor.

medical_deduction(?T, ?Year, ?Ded) :-
    medical_expenses(?T, ?Med),
    agi(?T, ?AGI),
    medical_floor_pct(?Year, ?Pct),
    ?Floor \is ?AGI * ?Pct,
    ?Temp \is ?Med - ?Floor,
    max2(?Temp, 0, ?Ded).

medical_deduction(?T, _Year, 0) :-
    \+ medical_expenses(?T, _).

// SALT deduction with cap.

salt_total(?T, ?Total) :-
    state_local_income_taxes(?T, ?Inc),
    ?Total \is ?Inc.

salt_total(?T, ?Total) :-
    state_local_sales_taxes(?T, ?Sales),
    ?Total \is ?Sales.

salt_total(?T, ?Total) :-
    real_estate_taxes(?T, ?RE),
    ?Total \is ?RE.

salt_total(?T, ?Total) :-
    personal_property_taxes(?T, ?PP),
    ?Total \is ?PP.

salt_deduction(?T, ?Year, ?Ded) :-
    salt_income_or_zero(?T, ?Inc),
    salt_sales_or_zero(?T, ?Sales),
    salt_re_or_zero(?T, ?RE),
    salt_pp_or_zero(?T, ?PP),
    ?Total \is ?Inc + ?Sales + ?RE + ?PP,
    salt_cap(?Year, ?Cap),
    min2(?Total, ?Cap, ?Ded).

salt_income_or_zero(?T, ?Inc) :-
    state_local_income_taxes(?T, ?Inc).
salt_income_or_zero(?T, 0) :-
    \+ state_local_income_taxes(?T, _).

salt_sales_or_zero(?T, ?Sales) :-
    state_local_sales_taxes(?T, ?Sales).
salt_sales_or_zero(?T, 0) :-
    \+ state_local_sales_taxes(?T, _).

salt_re_or_zero(?T, ?RE) :-
    real_estate_taxes(?T, ?RE).
salt_re_or_zero(?T, 0) :-
    \+ real_estate_taxes(?T, _).

salt_pp_or_zero(?T, ?PP) :-
    personal_property_taxes(?T, ?PP).
salt_pp_or_zero(?T, 0) :-
    \+ personal_property_taxes(?T, _).

// Itemized total (components that are provided).

itemized_component(?T, ?Year, ?Amt) :-
    medical_deduction(?T, ?Year, ?Amt).

itemized_component(?T, ?Year, ?Amt) :-
    salt_deduction(?T, ?Year, ?Amt).

itemized_component(?T, _Year, ?Amt) :-
    mortgage_interest(?T, ?Amt).

itemized_component(?T, _Year, ?Amt) :-
    charitable_cash(?T, ?Amt).

itemized_component(?T, _Year, ?Amt) :-
    charitable_noncash(?T, ?Amt).

itemized_component(?T, _Year, ?Amt) :-
    casualty_losses(?T, ?Amt).

itemized_component(?T, _Year, ?Amt) :-
    other_itemized(?T, ?Amt).

itemized_deduction(?T, ?Year, ?Total) :-
    tax_year(?Year),
    medical_or_zero(?T, ?Year, ?Med),
    salt_or_zero(?T, ?Year, ?Salt),
    mortgage_interest_or_zero(?T, ?MI),
    charitable_cash_or_zero(?T, ?CC),
    charitable_noncash_or_zero(?T, ?CNC),
    casualty_losses_or_zero(?T, ?Cas),
    other_itemized_or_zero(?T, ?Other),
    ?Total \is ?Med + ?Salt + ?MI + ?CC + ?CNC + ?Cas + ?Other.

medical_or_zero(?T, ?Year, ?Amt) :-
    medical_deduction(?T, ?Year, ?Amt).
medical_or_zero(?T, ?Year, 0) :-
    tax_year(?Year),
    \+ medical_deduction(?T, ?Year, _).

salt_or_zero(?T, ?Year, ?Amt) :-
    salt_deduction(?T, ?Year, ?Amt).
salt_or_zero(?T, ?Year, 0) :-
    tax_year(?Year),
    \+ salt_deduction(?T, ?Year, _).

mortgage_interest_or_zero(?T, ?Amt) :-
    mortgage_interest(?T, ?Amt).
mortgage_interest_or_zero(?T, 0) :-
    \+ mortgage_interest(?T, _).

charitable_cash_or_zero(?T, ?Amt) :-
    charitable_cash(?T, ?Amt).
charitable_cash_or_zero(?T, 0) :-
    \+ charitable_cash(?T, _).

charitable_noncash_or_zero(?T, ?Amt) :-
    charitable_noncash(?T, ?Amt).
charitable_noncash_or_zero(?T, 0) :-
    \+ charitable_noncash(?T, _).

casualty_losses_or_zero(?T, ?Amt) :-
    casualty_losses(?T, ?Amt).
casualty_losses_or_zero(?T, 0) :-
    \+ casualty_losses(?T, _).

other_itemized_or_zero(?T, ?Amt) :-
    other_itemized(?T, ?Amt).
other_itemized_or_zero(?T, 0) :-
    \+ other_itemized(?T, _).


// ---- /Users/z/Desktop/Coherent/Honor Thesis/rules/1040/2025/tax_brackets.ergo ----
// Tax liability rules for tax year 2025.

// 2025 brackets by status:
//   SINGLE:                     10%: 0–11,925; 12%: 11,926–48,475; 22%: 48,476–103,350;
//                               24%: 103,351–197,300; 32%: 197,301–250,525;
//                               35%: 250,526–626,350; 37%: 626,351+
//
//   MARRIED FILING JOINTLY / QUALIFYING SURVIVING SPOUSE:
//                               10%: 0–23,850; 12%: 23,851–96,950; 22%: 96,951–206,700;
//                               24%: 206,701–394,600; 32%: 394,601–501,050;
//                               35%: 501,051–751,600; 37%: 751,601+
//
//   MARRIED FILING SEPARATELY:  Same thresholds as Single, except top 35%/37% split at 375,800:
//                               10%: 0–11,925; 12%: 11,926–48,475; 22%: 48,476–103,350;
//                               24%: 103,351–197,300; 32%: 197,301–250,525;
//                               35%: 250,526–375,800; 37%: 375,801+
//
//   HEAD OF HOUSEHOLD:          10%: 0–17,000; 12%: 17,001–64,850; 22%: 64,851–103,350;
//                               24%: 103,351–197,300; 32%: 197,301–250,500;
//                               35%: 250,501–626,350; 37%: 626,351+

// ---------- SINGLE ----------

tax_liability(2025, single, ?TI, ?Tax) :-
    ?TI =< 11925,
    ?Tax \is 0.10 * ?TI.

tax_liability(2025, single, ?TI, ?Tax) :-
    ?TI > 11925, ?TI =< 48475,
    ?Tax \is 11925 * 0.10
             + 0.12 * (?TI - 11925).

tax_liability(2025, single, ?TI, ?Tax) :-
    ?TI > 48475, ?TI =< 103350,
    ?Tax \is 11925 * 0.10
             + (48475 - 11925) * 0.12
             + 0.22 * (?TI - 48475).

tax_liability(2025, single, ?TI, ?Tax) :-
    ?TI > 103350, ?TI =< 197300,
    ?Tax \is 11925 * 0.10
             + (48475 - 11925) * 0.12
             + (103350 - 48475) * 0.22
             + 0.24 * (?TI - 103350).

tax_liability(2025, single, ?TI, ?Tax) :-
    ?TI > 197300, ?TI =< 250525,
    ?Tax \is 11925 * 0.10
             + (48475 - 11925) * 0.12
             + (103350 - 48475) * 0.22
             + (197300 - 103350) * 0.24
             + 0.32 * (?TI - 197300).

tax_liability(2025, single, ?TI, ?Tax) :-
    ?TI > 250525, ?TI =< 626350,
    ?Tax \is 11925 * 0.10
             + (48475 - 11925) * 0.12
             + (103350 - 48475) * 0.22
             + (197300 - 103350) * 0.24
             + (250525 - 197300) * 0.32
             + 0.35 * (?TI - 250525).

tax_liability(2025, single, ?TI, ?Tax) :-
    ?TI > 626350,
    ?Tax \is 11925 * 0.10
             + (48475 - 11925) * 0.12
             + (103350 - 48475) * 0.22
             + (197300 - 103350) * 0.24
             + (250525 - 197300) * 0.32
             + (626350 - 250525) * 0.35
             + 0.37 * (?TI - 626350).

// ---------- MARRIED FILING JOINTLY ----------

tax_liability(2025, married_filing_jointly, ?TI, ?Tax) :-
    ?TI =< 23850,
    ?Tax \is 0.10 * ?TI.

tax_liability(2025, married_filing_jointly, ?TI, ?Tax) :-
    ?TI > 23850, ?TI =< 96950,
    ?Tax \is 23850 * 0.10
             + 0.12 * (?TI - 23850).

tax_liability(2025, married_filing_jointly, ?TI, ?Tax) :-
    ?TI > 96950, ?TI =< 206700,
    ?Tax \is 23850 * 0.10
             + (96950 - 23850) * 0.12
             + 0.22 * (?TI - 96950).

tax_liability(2025, married_filing_jointly, ?TI, ?Tax) :-
    ?TI > 206700, ?TI =< 394600,
    ?Tax \is 23850 * 0.10
             + (96950 - 23850) * 0.12
             + (206700 - 96950) * 0.22
             + 0.24 * (?TI - 206700).

