// Tax liability rules for tax year 2025.

// 2025 brackets by status:
//   SINGLE:                     10%: 0–11,925; 12%: 11,926–48,475; 22%: 48,476–103,350;
//                               24%: 103,351–197,300; 32%: 197,301–250,525;
//                               35%: 250,526–626,350; 37%: 626,351+
//
//   MARRIED FILING JOINTLY / QUALIFYING SURVIVING SPOUSE:
//                               10%: 0–23,850; 12%: 23,851–96,950; 22%: 96,951–206,700;
//                               24%: 206,701–394,600; 32%: 394,601–501,050;
//                               35%: 501,051–751,600; 37%: 751,601+
//
//   MARRIED FILING SEPARATELY:  Same thresholds as Single, except top 35%/37% split at 375,800:
//                               10%: 0–11,925; 12%: 11,926–48,475; 22%: 48,476–103,350;
//                               24%: 103,351–197,300; 32%: 197,301–250,525;
//                               35%: 250,526–375,800; 37%: 375,801+
//
//   HEAD OF HOUSEHOLD:          10%: 0–17,000; 12%: 17,001–64,850; 22%: 64,851–103,350;
//                               24%: 103,351–197,300; 32%: 197,301–250,500;
//                               35%: 250,501–626,350; 37%: 626,351+

// ---------- SINGLE ----------

tax_liability(2025, single, ?TI, ?Tax) :-
    ?TI =< 11925,
    ?Tax \is 0.10 * ?TI.

tax_liability(2025, single, ?TI, ?Tax) :-
    ?TI > 11925, ?TI =< 48475,
    ?Tax \is 11925 * 0.10
             + 0.12 * (?TI - 11925).

tax_liability(2025, single, ?TI, ?Tax) :-
    ?TI > 48475, ?TI =< 103350,
    ?Tax \is 11925 * 0.10
             + (48475 - 11925) * 0.12
             + 0.22 * (?TI - 48475).

tax_liability(2025, single, ?TI, ?Tax) :-
    ?TI > 103350, ?TI =< 197300,
    ?Tax \is 11925 * 0.10
             + (48475 - 11925) * 0.12
             + (103350 - 48475) * 0.22
             + 0.24 * (?TI - 103350).

tax_liability(2025, single, ?TI, ?Tax) :-
    ?TI > 197300, ?TI =< 250525,
    ?Tax \is 11925 * 0.10
             + (48475 - 11925) * 0.12
             + (103350 - 48475) * 0.22
             + (197300 - 103350) * 0.24
             + 0.32 * (?TI - 197300).

tax_liability(2025, single, ?TI, ?Tax) :-
    ?TI > 250525, ?TI =< 626350,
    ?Tax \is 11925 * 0.10
             + (48475 - 11925) * 0.12
             + (103350 - 48475) * 0.22
             + (197300 - 103350) * 0.24
             + (250525 - 197300) * 0.32
             + 0.35 * (?TI - 250525).

tax_liability(2025, single, ?TI, ?Tax) :-
    ?TI > 626350,
    ?Tax \is 11925 * 0.10
             + (48475 - 11925) * 0.12
             + (103350 - 48475) * 0.22
             + (197300 - 103350) * 0.24
             + (250525 - 197300) * 0.32
             + (626350 - 250525) * 0.35
             + 0.37 * (?TI - 626350).

// ---------- MARRIED FILING JOINTLY ----------

tax_liability(2025, married_filing_jointly, ?TI, ?Tax) :-
    ?TI =< 23850,
    ?Tax \is 0.10 * ?TI.

tax_liability(2025, married_filing_jointly, ?TI, ?Tax) :-
    ?TI > 23850, ?TI =< 96950,
    ?Tax \is 23850 * 0.10
             + 0.12 * (?TI - 23850).

tax_liability(2025, married_filing_jointly, ?TI, ?Tax) :-
    ?TI > 96950, ?TI =< 206700,
    ?Tax \is 23850 * 0.10
             + (96950 - 23850) * 0.12
             + 0.22 * (?TI - 96950).

tax_liability(2025, married_filing_jointly, ?TI, ?Tax) :-
    ?TI > 206700, ?TI =< 394600,
    ?Tax \is 23850 * 0.10
             + (96950 - 23850) * 0.12
             + (206700 - 96950) * 0.22
             + 0.24 * (?TI - 206700).

tax_liability(2025, married_filing_jointly, ?TI, ?Tax) :-
    ?TI > 394600, ?TI =< 501050,
    ?Tax \is 23850 * 0.10
             + (96950 - 23850) * 0.12
             + (206700 - 96950) * 0.22
             + (394600 - 206700) * 0.24
             + 0.32 * (?TI - 394600).

tax_liability(2025, married_filing_jointly, ?TI, ?Tax) :-
    ?TI > 501050, ?TI =< 751600,
    ?Tax \is 23850 * 0.10
             + (96950 - 23850) * 0.12
             + (206700 - 96950) * 0.22
             + (394600 - 206700) * 0.24
             + (501050 - 394600) * 0.32
             + 0.35 * (?TI - 501050).

tax_liability(2025, married_filing_jointly, ?TI, ?Tax) :-
    ?TI > 751600,
    ?Tax \is 23850 * 0.10
             + (96950 - 23850) * 0.12
             + (206700 - 96950) * 0.22
             + (394600 - 206700) * 0.24
             + (501050 - 394600) * 0.32
             + (751600 - 501050) * 0.35
             + 0.37 * (?TI - 751600).

// Qualifying surviving spouse shares the MFJ brackets.

tax_liability(2025, qualifying_surviving_spouse, ?TI, ?Tax) :-
    tax_liability(2025, married_filing_jointly, ?TI, ?Tax).

