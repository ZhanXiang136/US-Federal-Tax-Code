tax_liability(2025, head_of_household, ?TI, ?Tax) :-
    ?TI > 250500, ?TI =< 626350,
    ?Tax \is 17000 * 0.10
             + (64850 - 17000) * 0.12
             + (103350 - 64850) * 0.22
             + (197300 - 103350) * 0.24
             + (250500 - 197300) * 0.32
