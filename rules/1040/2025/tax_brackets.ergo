    ?Tax \is 11925 * 0.10
             + (48475 - 11925) * 0.12
             + (103350 - 48475) * 0.22
             + (197300 - 103350) * 0.24
             + (250525 - 197300) * 0.32
             + 0.35 * (?TI - 250525).

tax_liability(2025, married_filing_separately, ?TI, ?Tax) :-
    ?TI > 375800,
    ?Tax \is 11925 * 0.10
             + (48475 - 11925) * 0.12
             + (103350 - 48475) * 0.22
             + (197300 - 103350) * 0.24
             + (250525 - 197300) * 0.32
             + (375800 - 250525) * 0.35
             + 0.37 * (?TI - 375800).

// ---------- HEAD OF HOUSEHOLD ----------

