// Itemized-deduction and explainability examples for 2025.

// Example: Erin (single)
//  - Wages: 100,000
//  - Medical expenses: 10,000
//  - State/local income taxes: 8,000
//  - Real estate taxes: 4,000
//  - Mortgage interest: 8,000
//  - Charitable cash: 2,000
//
// Expected values:
//  - AGI = 100,000
//  - Medical deduction = 10,000 - (7.5% * 100,000) = 2,500
//  - SALT deduction = min(8,000 + 4,000, 10,000) = 10,000
//  - Itemized deduction = 2,500 + 10,000 + 8,000 + 2,000 = 22,500
//  - Standard deduction = 15,750
//  - Deduction used = 22,500
//  - Taxable income = 77,500
//  - Tax = 11,964

filing_status(erin, single).
wage_income(erin, 100000).

medical_expenses(erin, 10000).
state_local_income_taxes(erin, 8000).
real_estate_taxes(erin, 4000).
mortgage_interest(erin, 8000).
charitable_cash(erin, 2000).

age_65_or_over_flag(erin, 0).
blind_flag(erin, 0).
spouse_age_65_or_over_flag(erin, 0).
spouse_blind_flag(erin, 0).

expected_itemized_deduction(erin, 22500).
expected_deduction_used(erin, 22500).
expected_taxable_income_itemized(erin, 77500).
expected_tax_itemized(erin, 11964.0).

itemized_case_ok(?T) :-
    tax_year(?Year),
    expected_itemized_deduction(?T, ?ExpID),
    expected_deduction_used(?T, ?ExpDed),
    expected_taxable_income_itemized(?T, ?ExpTI),
    expected_tax_itemized(?T, ?ExpTax),
    filing_status(?T, ?Status),
    itemized_deduction(?T, ?Year, ?ID),
    deduction_used(?T, ?Year, ?Ded),
    taxable_income(?T, ?Year, ?TI),
    tax_liability(?Year, ?Status, ?TI, ?Tax),
    ?ID =:= ?ExpID,
    ?Ded =:= ?ExpDed,
    ?TI =:= ?ExpTI,
    ?Tax =:= ?ExpTax.

explainability_case_ok(erin) :-
    line_value(erin, 'agi', ?AGI),
    ?AGI =:= 100000,
    line_explanation(erin, 'agi', ?_ExplainAGI),
    line_value(erin, 'itemized_deduction', ?ID),
    ?ID =:= 22500,
    line_explanation(erin, 'itemized_deduction', ?_ExplainItemized),
    line_value(erin, 'deduction_used', ?Ded),
    ?Ded =:= 22500,
    line_explanation(erin, 'deduction_used', ?_ExplainDeductionUsed),
    line_value(erin, 'taxable_income', ?TI),
    ?TI =:= 77500,
    line_explanation(erin, 'taxable_income', ?_ExplainTaxableIncome),
    line_value(erin, 'tax_liability', ?Tax),
    ?Tax =:= 11964.0,
    line_explanation(erin, 'tax_liability', ?_ExplainTax).
